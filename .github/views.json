{
  "views": [
    {
      "name": "All",
      "layout": "table",
      "include_test_tickets": true,
      "include_pull_requests": true,
      "sort_by": [["Created", "asc"]],
      "manual_steps": ["turn off \"Show hierarchy\", so that tickets are not listed inside their Version ticket and the list is flat"],
      "visible_fields": ["Title", "Assignees", "Status", "Type", "Labels", "Priority", "Size", "Risk", "Waiting", "Attention", "Fix", "Resolution", "Delivery", "Origin", "REF", "Version", "Build", "Start date", "End date"]
    },
    {
      "name": "Backlog",
      "layout": "board",
      "filter": "status:ToDo,OnDeck,Suspended",
      "vertical_group_by": "Status",
      "sort_by": [["Priority", "asc"]],
      "visible_fields": ["Title", "Priority", "Size", "Risk", "Version", "Assignees", "Type"]
    },
    {
      "name": "Board",
      "layout": "board",
      "filter": "is:open AND -type:Version AND -status:ToDo,Suspended",
      "group_by": "Version",
      "vertical_group_by": "Status",
      "sort_by": [["Priority", "asc"]],
      "visible_fields": ["Title", "Priority", "Size", "Assignees", "Waiting", "Attention", "Type"]
    },
    {
      "name": "Decide",
      "layout": "table",
      "filter": "attention:Watch,Caution,AtRisk OR (type:Alert AND is:open)",
      "sort_by": [["Priority", "asc"]],
      "visible_fields": ["Title", "Assignees", "Status", "Type", "Labels", "Attention", "Priority", "Waiting", "Delivery", "Version"]
    },
    {
      "name": "Follow up",
      "layout": "table",
      "filter": "has:waiting OR status:Review",
      "sort_by": [["Priority", "asc"]],
      "visible_fields": ["Title", "Assignees", "Status", "Type", "Labels", "Waiting", "Priority", "Size", "Risk", "Resolution", "Delivery", "Version"]
    },
    {
      "name": "Fix",
      "layout": "table",
      "filter": "has:fix",
      "sort_by": [["Priority", "asc"]],
      "visible_fields": ["Title", "Assignees", "Fix", "Status", "Type", "Labels", "Priority", "Resolution", "Delivery", "Version", "Build", "End date", "REF"]
    },
    {
      "name": "Versions",
      "layout": "table",
      "filter": "has:version AND -type:Version",
      "group_by": "Parent issue",
      "sort_by": [["Version#", "asc"], ["Priority", "asc"]],
      "visible_fields": ["Title", "Status", "Type", "Labels", "Assignees", "Priority", "Size", "Delivery", "Resolution", "Version", "Build"]
    }
  ]
}
