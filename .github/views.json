{
  "views": [
    {
      "name": "All",
      "layout": "table",
      "sort_by": [["Version#", "desc"], ["Priority", "asc"]],
      "visible_fields": ["Title", "Assignees", "Status", "Type", "Labels", "Origin", "REF", "Waiting", "Attention", "Resolution", "Delivery", "Priority", "Size", "Risk", "Version", "Build", "Version#", "Start date", "End date"]
    },
    {
      "name": "Backlog",
      "layout": "board",
      "filter": "status:ToDo,OnDeck,Suspended",
      "vertical_group_by": "Status",
      "sort_by": [["Priority", "asc"]],
      "visible_fields": ["Title", "Priority", "Size", "Risk", "Version", "Assignees", "Type"]
    },
    {
      "name": "Board",
      "layout": "board",
      "filter": "is:open AND -type:Version AND -status:ToDo,Suspended",
      "group_by": "Version",
      "vertical_group_by": "Status",
      "sort_by": [["Priority", "asc"]],
      "visible_fields": ["Title", "Priority", "Size", "Assignees", "Waiting", "Attention", "Type"]
    },
    {
      "name": "Health",
      "layout": "table",
      "filter": "attention:Watch,Caution,AtRisk OR waiting:\"Needs input\" OR status:Review OR (type:Alert AND is:open) OR (status:Completed no:resolution) OR (is:open has:resolution) OR (is:open has:end-date) OR (is:closed has:waiting) OR (origin:Backfilled no:ref) OR (status:Completed,Abandoned AND is:open) OR (is:closed AND -status:Completed,Abandoned AND -type:Version)",
      "sort_by": [["Priority", "asc"]],
      "visible_fields": ["Title", "Assignees", "Status", "Type", "Attention", "Waiting", "Resolution", "Delivery", "End date", "REF", "Priority"]
    },
    {
      "name": "Versions",
      "layout": "table",
      "filter": "has:version AND -type:Version",
      "group_by": "Version#",
      "sort_by": [["Priority", "asc"]],
      "visible_fields": ["Title", "Status", "Type", "Delivery", "Build", "Resolution", "Version", "Priority"]
    }
  ]
}
